{% comment %}
  Product reviews / testimonials slider.
  Reads list.metaobject_reference from product (default: custom.featured_reviews).

  Metaobject fields (existing "review" type works):
  - quote — required
  - who_said_it — author
  - rating — optional number 1–5
{% endcomment %}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'section-product-reviews-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign metafield_namespace = section.settings.metafield_namespace | default: 'custom' | strip
  assign metafield_key = section.settings.metafield_key | default: 'featured_reviews' | strip
  assign review_list = product.metafields[metafield_namespace][metafield_key].value
  assign single_review = blank
  assign review_count = 0

  if review_list != blank
    for review in review_list
      assign quote_check = review.quote.value | default: review.quote
      if quote_check != blank
        assign review_count = review_count | plus: 1
      endif
    endfor
  elsif section.settings.fallback_to_single_review
    assign single_review = product.metafields.custom.review.value
    if single_review != blank
      assign quote_check = single_review.quote.value | default: single_review.quote
      if quote_check != blank
        assign review_count = 1
      endif
    endif
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if review_count > 0 or request.design_mode -%}
  <div class="product-reviews-slider color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if review_count <= 1 %} product-reviews-slider--single{% endif %}">
    <div class="page-width">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="product-reviews-slider__header">
          {%- if section.settings.heading != blank -%}
            <h2 class="product-reviews-slider__heading {{ section.settings.heading_size }}">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="product-reviews-slider__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if review_count > 0 -%}
        <slider-component class="product-reviews-slider__slider slider-mobile-gutter">
          <ul
            id="Slider-{{ section.id }}"
            class="product-reviews-slider__list grid grid--peek grid--1-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop slider slider--tablet slider--desktop"
            role="list"
            aria-label="{{ section.settings.heading | default: 'Reviews' | escape }}"
          >
          {%- if review_list != blank -%}
            {%- assign slide_index = 0 -%}
            {%- for review in review_list -%}
              {%- liquid
                assign quote = review.quote.value | default: review.quote
                if quote == blank
                  continue
                endif
                assign author = review.who_said_it.value | default: review.who_said_it
                if author == blank
                  assign author = review.author.value | default: review.author
                endif
                assign rating = review.rating.value | default: review.rating
                assign slide_index = slide_index | plus: 1
              -%}
              <li
                id="Slide-{{ section.id }}-{{ slide_index }}"
                class="grid__item slider__slide product-reviews-slider__slide"
              >
                {% render 'product-review-slide', quote: quote, author: author, rating: rating %}
              </li>
            {%- endfor -%}
          {%- elsif single_review != blank -%}
            {%- liquid
              assign quote = single_review.quote.value | default: single_review.quote
              assign author = single_review.who_said_it.value | default: single_review.who_said_it
              assign rating = single_review.rating.value | default: single_review.rating
            -%}
            <li id="Slide-{{ section.id }}-1" class="grid__item slider__slide product-reviews-slider__slide">
              {% render 'product-review-slide', quote: quote, author: author, rating: rating %}
            </li>
          {%- endif -%}
          </ul>

          {%- if review_count > 1 -%}
            <div class="product-reviews-slider__controls slider-buttons no-js-hidden">
              <button
                type="button"
                class="slider-button slider-button--prev"
                name="previous"
                aria-label="{{ 'general.slider.previous_slide' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </button>
              <button
                type="button"
                class="slider-button slider-button--next"
                name="next"
                aria-label="{{ 'general.slider.next_slide' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- endif -%}
        </slider-component>
      {%- elsif request.design_mode -%}
        <p class="product-reviews-slider__author" style="text-align: center">
          {{ 'sections.product_reviews_slider.empty' | t }}
        </p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.product_reviews_slider.name",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.product_reviews_slider.settings.paragraph.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.product_reviews_slider.settings.heading.label",
      "default": "t:sections.product_reviews_slider.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.product_reviews_slider.settings.heading_size.label",
      "options": [
        { "value": "h2", "label": "t:sections.product_reviews_slider.settings.heading_size.options__1.label" },
        { "value": "h3", "label": "t:sections.product_reviews_slider.settings.heading_size.options__2.label" },
        { "value": "h4", "label": "t:sections.product_reviews_slider.settings.heading_size.options__3.label" }
      ],
      "default": "h2"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.product_reviews_slider.settings.subheading.label"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.product_reviews_slider.settings.columns_desktop.label",
      "options": [
        { "value": "2", "label": "t:sections.product_reviews_slider.settings.columns_desktop.options__1.label" },
        { "value": "3", "label": "t:sections.product_reviews_slider.settings.columns_desktop.options__2.label" },
        { "value": "4", "label": "t:sections.product_reviews_slider.settings.columns_desktop.options__3.label" }
      ],
      "default": "3"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "t:sections.product_reviews_slider.settings.metafield_namespace.label",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "t:sections.product_reviews_slider.settings.metafield_key.label",
      "default": "featured_reviews",
      "info": "t:sections.product_reviews_slider.settings.metafield_key.info"
    },
    {
      "type": "checkbox",
      "id": "fallback_to_single_review",
      "label": "t:sections.product_reviews_slider.settings.fallback_to_single_review.label",
      "default": true,
      "info": "t:sections.product_reviews_slider.settings.fallback_to_single_review.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_reviews_slider.name"
    }
  ]
}
{% endschema %}
