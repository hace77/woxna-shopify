{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="collapsible-content collapsible-{{ section.settings.layout }}-layout isolate{% if section.settings.layout == 'section' %} page-width{% elsif section.settings.layout == 'none' %} content-container content-container--full-width{% endif %}">
    <div class="collapsible-content__wrapper section-{{ section.id }}-padding{% if section.settings.layout == 'section' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}">
      <div class="{% if section.settings.image != blank or section.settings.content_width == 'page' %}page-width{% else %}collapsible-content-wrapper-narrow{% endif %}">
        {%- if section.settings.caption != blank or section.settings.heading != blank -%}
          <div
            class="collapsible-content__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            style="text-align: {{ section.settings.heading_alignment }};"
          >
            {%- if section.settings.caption != blank -%}
              <p class="caption-with-letter-spacing">
                {{ section.settings.caption | escape }}
              </p>
            {% endif %}
            {%- if section.settings.heading != blank -%}
              <h2 class="collapsible-content__heading inline-richtext {{ section.settings.heading_size }} mobile-{{ section.settings.mobile_heading_size | default: section.settings.heading_size }}">
                {{ section.settings.heading }}
              </h2>
            {% endif %}
          </div>
        {%- else -%}
          <h2 class="visually-hidden">{{ 'accessibility.collapsible_content_title' | t }}</h2>
        {%- endif -%}
        <div class="grid grid--1-col{% if section.settings.image != blank %} grid--2-col-tablet{% endif %} collapsible-content__grid{% if section.settings.image != blank and section.settings.desktop_layout == 'image_second' %} collapsible-content__grid--reverse{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if section.settings.image != blank -%}
            <div class="grid__item collapsible-content__grid-item">
              <div
                class="collapsible-content__media collapsible-content__media--{{ section.settings.image_ratio }} media global-media-settings gradient"
                {% if section.settings.image_ratio == 'adapt' %}
                  style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
                {% endif %}
              >
                {%- liquid
                  assign padding_multiplier = 1
                  if section.settings.layout == 'section'
                    assign padding_multiplier = 2
                  endif
                  assign desktop_tablet_padding = 100 | times: padding_multiplier | append: 'px'
                  assign mobile_padding = 30 | times: padding_multiplier | append: 'px'
                -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ desktop_tablet_padding }}) / 2),
                  (min-width: 750px) calc((100vw - {{ desktop_tablet_padding }}) / 2),
                  calc(100vw - {{ mobile_padding }})
                {%- endcapture -%}
                {{
                  section.settings.image
                  | image_url: width: 3200
                  | image_tag:
                    sizes: sizes,
                    widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200'
                }}
              </div>
            </div>
          {% endif %}
          <div class="grid__item">
            {%- assign first_visible_row_opened = false -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign show_collapsible_row = true
                assign is_klaviyo_product_reviews_app = false
                assign app_probe = block.type | append: '-' | append: block.id

                if block.type == 'klaviyo_reviews'
                  # Legacy empty embed block — hide. Use Apps → Product reviews instead.
                  assign show_collapsible_row = false
                elsif block.type == '@app' or app_probe contains 'shopify://apps/'
                  # App blocks in this section are wrapped as the reviews accordion.
                  # Skip star-rating / average-rating / carousel widgets (those belong elsewhere).
                  unless app_probe contains 'average-rating' or app_probe contains 'average_rating' or app_probe contains 'featured-reviews' or app_probe contains 'featured_reviews' or app_probe contains 'star-rating-badge'
                    assign is_klaviyo_product_reviews_app = true
                  endunless

                  if is_klaviyo_product_reviews_app
                    if product == blank
                      assign show_collapsible_row = false
                    elsif section.settings.klaviyo_reviews_hide_when_no_reviews
                      if product.metafields.reviews.rating_count == blank or product.metafields.reviews.rating_count == 0
                        assign show_collapsible_row = false
                      endif
                    endif
                  endif
                elsif block.settings.hide_when_empty
                  capture collapsible_row_body
                    echo block.settings.row_content
                    if block.settings.page != blank
                      echo block.settings.page.content
                    endif
                  endcapture
                  assign collapsible_row_body_stripped = collapsible_row_body | strip_html | strip
                  if collapsible_row_body_stripped == blank
                    assign show_collapsible_row = false
                  endif
                endif

                assign open_collapsible_row = false
                if is_klaviyo_product_reviews_app and section.settings.klaviyo_reviews_open_by_default
                  assign open_collapsible_row = true
                elsif block.settings.open_by_default
                  assign open_collapsible_row = true
                elsif section.settings.open_first_collapsible_row and first_visible_row_opened == false and show_collapsible_row
                  assign open_collapsible_row = true
                  assign first_visible_row_opened = true
                endif
              -%}
              {%- if show_collapsible_row -%}
                {%- if is_klaviyo_product_reviews_app -%}
                  <div
                    class="accordion accordion--klaviyo-reviews{% if section.settings.layout == 'row' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    <details
                      id="Details-{{ block.id }}-{{ section.id }}"
                      {% if open_collapsible_row %}
                        open
                      {% endif %}
                    >
                      <summary id="Summary-{{ block.id }}-{{ section.id }}">
                        {% render 'icon-accordion', icon: section.settings.klaviyo_reviews_icon %}
                        <h3 class="accordion__title accordion__title--with-klaviyo inline-richtext {{ section.settings.klaviyo_reviews_heading_size | default: 'h4' }} mobile-{{ section.settings.klaviyo_reviews_mobile_heading_size | default: section.settings.klaviyo_reviews_heading_size | default: 'h4' }}{% if section.settings.klaviyo_reviews_heading_uppercase or section.settings.accordion_heading_uppercase %} accordion__title--uppercase{% endif %}">
                          <span class="accordion__title-text">
                            {{ section.settings.klaviyo_reviews_heading | default: 'Reviews' | escape }}
                          </span>
                          {%- if section.settings.klaviyo_reviews_show_star_rating -%}
                            <span
                              class="klaviyo-star-rating-widget"
                              data-id="{{ product.id }}"
                              data-product-title="{{ product.title | escape }}"
                              data-product-type="{{ product.type | escape }}"
                            ></span>
                          {%- endif -%}
                        </h3>
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </summary>
                      <div
                        class="accordion__content accordion__content--klaviyo-reviews"
                        id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                        role="region"
                        aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
                      >
                        {% render block %}
                      </div>
                    </details>
                  </div>
                {%- elsif block.type == '@app' or app_probe contains 'shopify://apps/' -%}
                  <div {{ block.shopify_attributes }}>
                    {% render block %}
                  </div>
                {%- else -%}
                  <div
                    class="accordion{% if section.settings.layout == 'row' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    <details
                      id="Details-{{ block.id }}-{{ section.id }}"
                      {% if open_collapsible_row %}
                        open
                      {% endif %}
                    >
                      <summary id="Summary-{{ block.id }}-{{ section.id }}">
                        {% render 'icon-accordion', icon: block.settings.icon %}
                        <h3 class="accordion__title inline-richtext {{ block.settings.heading_size | default: 'h4' }} mobile-{{ block.settings.mobile_heading_size | default: block.settings.heading_size | default: 'h4' }}{% if block.settings.heading_uppercase or section.settings.accordion_heading_uppercase %} accordion__title--uppercase{% endif %}">
                          {{ block.settings.heading | default: block.settings.page.title | escape }}
                        </h3>
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </summary>
                      <div
                        class="accordion__content rte accordion__content--font-{{ block.settings.body_size | default: 'medium' }}"
                        id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                        role="region"
                        aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
                      >
                        {{ block.settings.row_content }}
                        {{ block.settings.page.content }}
                      </div>
                    </details>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

