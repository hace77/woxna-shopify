{%- comment -%}
  Promotional hero tile inserted into a product grid after a given product.
  Accepts:
  - product_index: {Number} forloop.index of the product just rendered
  - extra_class: {String} optional extra classes on the <li>
  - skip_desktop: {Boolean} skip the desktop-positioned tile (e.g. desktop slider)
  - skip_mobile: {Boolean} skip the mobile-positioned tile (e.g. mobile slider)
{%- endcomment -%}

{%- if section.settings.show_hero_block_1 -%}
  {%- liquid
    assign hero_position_desktop = section.settings.hero_block_1_position_desktop | plus: 0
    assign hero_position_mobile = section.settings.hero_block_1_position_mobile | plus: 0
    assign show_hero_desktop = false
    assign show_hero_mobile = false

    unless skip_desktop
      if product_index == hero_position_desktop
        assign show_hero_desktop = true
      endif
    endunless
    unless skip_mobile
      if product_index == hero_position_mobile
        assign show_hero_mobile = true
      endif
    endunless
  -%}
  {%- if show_hero_desktop or show_hero_mobile -%}
    <li class="grid__item hero-block-item hero-block--{{ section.settings.hero_block_1_size }}{% if show_hero_desktop %} hero-block--desktop{% endif %}{% if show_hero_mobile %} hero-block--mobile{% endif %}{% if extra_class != blank %} {{ extra_class }}{% endif %}">
      {%- if section.settings.hero_block_1_button_url != blank -%}
        <a href="{{ section.settings.hero_block_1_button_url }}" class="hero-block-link">
      {%- endif -%}
        <div class="hero-block color-{{ section.settings.hero_block_1_color_scheme }} gradient">
          {%- if section.settings.hero_block_1_image -%}
            <div class="hero-block__background">
              {{
                section.settings.hero_block_1_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '375, 550, 750, 1100, 1200',
                  alt: section.settings.hero_block_1_heading
              }}
            </div>
          {%- endif -%}

          {%- liquid
            assign hero_heading_size = section.settings.hero_block_1_heading_size
            assign hero_mobile_heading_size = section.settings.hero_block_1_mobile_heading_size | default: hero_heading_size
          -%}
          <div class="hero-block__content hero-block__content--{{ section.settings.hero_block_1_vertical_position }} hero-block__content--mobile-{{ section.settings.hero_block_1_mobile_vertical_position }} hero-block__content--text-{{ section.settings.hero_block_1_text_alignment }} hero-block__content--mobile-text-{{ section.settings.hero_block_1_mobile_text_alignment }}">
            {%- if section.settings.hero_block_1_heading != blank -%}
              <h2 class="hero-block__heading {{ hero_heading_size }} mobile-{{ hero_mobile_heading_size }}">{{ section.settings.hero_block_1_heading }}</h2>
            {%- endif -%}

            {%- if section.settings.hero_block_1_text != blank -%}
              <div class="hero-block__text rte">{{ section.settings.hero_block_1_text }}</div>
            {%- endif -%}

            {%- if section.settings.hero_block_1_button_text != blank and section.settings.hero_block_1_button_url != blank -%}
              <span class="hero-block__button button button--primary">
                {{ section.settings.hero_block_1_button_text }}
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- if section.settings.hero_block_1_button_url != blank -%}
        </a>
      {%- endif -%}
    </li>
  {%- endif -%}
{%- endif -%}
