{% doc %}
  Renders a low-stock product label when sellable quantity is 1–5.
  For combo products with custom.combine_collection, sellable qty is the
  minimum inventory across component products. Otherwise uses the product's
  own variant inventory sum.

  @param {object} product - Product drop
{% enddoc %}

{%- liquid
  assign sellable_inventory = 0
  assign used_combo_inventory = false
  assign combo_collection = product.metafields.custom.combine_collection.value

  if combo_collection != blank and combo_collection.products.size > 0
    assign used_combo_inventory = true
    assign combo_min_set = false

    for component in combo_collection.products
      assign component_inventory = 0
      for variant in component.variants
        assign component_inventory = component_inventory | plus: variant.inventory_quantity
      endfor

      if combo_min_set == false or component_inventory < sellable_inventory
        assign sellable_inventory = component_inventory
        assign combo_min_set = true
      endif
    endfor
  endif

  unless used_combo_inventory
    assign sellable_inventory = 0
    for variant in product.variants
      assign sellable_inventory = sellable_inventory | plus: variant.inventory_quantity
    endfor
  endunless
-%}

{%- if product.available and sellable_inventory > 0 and sellable_inventory <= 5 -%}
  <div class="product-label custom-label stock-label">
    {{ 'products.product.inventory_low_stock_show_count' | t: quantity: sellable_inventory }}
  </div>
{%- endif -%}
