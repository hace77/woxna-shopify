{% comment %}
  Payment method logos as a movable product block.
  Accepts:
  - block: {Object} payment_icons block
{% endcomment %}

{%- liquid
  assign payment_icons = shop.enabled_payment_types
  if block.settings.payment_icon_types != blank
    assign payment_icons = block.settings.payment_icon_types | replace: ' ', '' | split: ','
  endif
-%}

{%- if payment_icons.size > 0 -%}
  <div class="product-form__payment-icons" {{ block.shopify_attributes }}>
    {%- liquid
      assign payment_heading = 'products.product.payment_options' | t
      if block.settings.heading != blank
        assign payment_heading = block.settings.heading
      endif
    -%}
    <p class="product-form__payment-icons-heading">{{ payment_heading | escape }}</p>
    <ul class="product-form__payment-icons-list" role="list">
      {%- for type in payment_icons -%}
        {%- assign payment_type = type | strip | downcase -%}
        {%- if payment_type == blank -%}
          {%- continue -%}
        {%- endif -%}
        {%- capture payment_icon -%}
          {%- case payment_type -%}
            {%- when 'swish' -%}
              {{ 'icon-payment-swish.svg' | inline_asset_content }}
            {%- when 'klarna' -%}
              {{ 'icon-payment-klarna.svg' | inline_asset_content }}
            {%- else -%}
              {{ payment_type | payment_type_svg_tag: class: 'icon icon--full-color' }}
          {%- endcase -%}
        {%- endcapture -%}
        {%- if payment_icon != blank -%}
          <li class="product-form__payment-icons-item">
            {{ payment_icon }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}
